{
  "name": "days-of-decay",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "check": "biome check --write && turbo typecheck && pnpm run knip",
    "check:ci": "biome check && turbo typecheck && pnpm run knip",
    "docs": "turbo run docs && pnpm run docs:index",
    "docs:index": "./tools/poe/bin/poe index realms tools packages apps",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "knip": "^6.15.0",
    "poe": "workspace:*",
    "turbo": "^2.9.16"
  }
}
