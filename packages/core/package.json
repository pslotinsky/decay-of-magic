{
  "name": "@dod/core",
  "version": "0.0.1",
  "description": "Framework-agnostic runtime kernels — Entity, ZodBody, error types",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./collection": {
      "types": "./dist/collection/index.d.ts",
      "default": "./dist/collection/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "docs": "poe inspect"
  },
  "dependencies": {
    "@dod/api-contract": "workspace:*",
    "lodash": "^4.18.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "rxjs": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@dod/config": "workspace:*",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.6.2",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "rxjs": "^7.8.2",
    "typescript": "^6.0.3",
    "zod": "^4.4.2"
  }
}
