{
  "name": "@dod/engine",
  "version": "0.0.1",
  "description": "Battle engine — match rules: card effects, abilities, combat, turn flow",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit && pnpm run test:flow",
    "test:unit": "jest --config ./test/jest-unit.json",
    "test:flow": "jest --config ./test/jest-flow.json",
    "format": "biome format --write src",
    "lint": "biome lint --write src",
    "docs": "poe inspect"
  },
  "dependencies": {
    "pure-rand": "^8.4.1",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@dod/config": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  }
}
