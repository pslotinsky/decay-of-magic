{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["DATABASE_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "prisma:generate"],
      "outputs": ["dist/**"]
    },
    "prisma:generate": {
      "outputs": ["prisma/generated/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "test:unit": {
      "dependsOn": ["^build", "prisma:generate"]
    },
    "test:flow": {
      "dependsOn": ["^build", "prisma:generate"]
    },
    "test:api": {
      "dependsOn": ["^build", "prisma:generate"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build", "prisma:generate"]
    },
    "typecheck": {
      "dependsOn": ["^build", "prisma:generate"]
    },
    "docs": {
      "dependsOn": ["poe#build"],
      "cache": false
    }
  }
}
