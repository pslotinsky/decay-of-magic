{
  "name": "lab",
  "version": "0.0.1",
  "description": "Simulation realm — drives the engine to produce balance signal",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "test": "pnpm run test:unit && pnpm run test:flow && pnpm run test:api",
    "test:unit": "jest --config ./test/jest-unit.json",
    "test:flow": "jest --config ./test/jest-flow.json",
    "test:api": "jest --config ./test/jest-api.json",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write src",
    "lint": "biome lint --write src",
    "docs": "poe inspect"
  },
  "dependencies": {
    "@dod/core": "workspace:*",
    "@dod/engine": "workspace:*",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/cqrs": "^11.0.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@dod/config": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.2",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  }
}
