# Dependencies & build outputs
**/node_modules
**/dist
**/build
**/.turbo
**/*.tsbuildinfo
**/coverage
**/.nyc_output

# Regenerated inside the image
**/prisma/generated

# Git / CI
.git
.gitignore
.gitattributes
.github

# IDE
.vscode
.idea
*.sublime-workspace
*.suo

# OS
.DS_Store
Thumbs.db

