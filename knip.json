{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    "duplicates": "off"
  },
  "workspaces": {
    "packages/config": {
      "entry": []
    },
    "packages/engine": {
      "entry": ["poe.config.mjs", "test/unit/*.spec.ts", "test/flow/*.spec.ts"]
    },
    "packages/*": {
      "entry": ["poe.config.mjs"]
    },
    "tools/*": {
      "entry": ["src/index.ts", "poe.config.mjs"]
    },
    "realms/citizen": {
      "entry": ["src/main.ts", "poe.config.mjs", "test/api/*.api-spec.ts"]
    },
    "realms/lab": {
      "entry": [
        "poe.config.mjs",
        "src/**/*.ts",
        "test/unit/*.unit-spec.ts",
        "test/api/*.api-spec.ts"
      ]
    },
    "realms/codex": {
      "entry": [
        "src/main.ts",
        "poe.config.mjs",
        "test/api/*.api-spec.ts",
        "test/flow/*.flow-spec.ts"
      ]
    },
    "realms/universe": {
      "entry": ["src/main.ts", "poe.config.mjs", "test/api/*.api-spec.ts"]
    },
    "realms/gateway": {
      "entry": ["src/main.ts", "poe.config.mjs"]
    },
    "realms/vault": {
      "entry": ["src/main.ts", "poe.config.mjs"]
    }
  }
}
