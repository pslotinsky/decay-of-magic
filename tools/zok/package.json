{
  "name": "zok",
  "private": true,
  "version": "0.0.1",
  "description": "The archivist — CLI for managing tasks, milestones, ADRs, and design docs",
  "bin": "./bin/zok",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias",
    "start": "node ./dist/index.js",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "docs": "poe inspect",
    "format": "biome format --write src",
    "lint": "biome lint --write src"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "commander": "^14.0.3",
    "date-fns": "^4.3.0",
    "lodash": "^4.18.1",
    "nanoid": "^5.1.11",
    "nunjucks": "^3.2.4",
    "prettier": "^3.8.3",
    "source-map-support": "^0.5.21",
    "yaml": "^2.8.4"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.9.1",
    "@types/nunjucks": "^3.2.6",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
