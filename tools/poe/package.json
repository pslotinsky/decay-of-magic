{
  "name": "poe",
  "version": "0.0.1",
  "description": "The inspector — generates README documentation by scanning workspace sources",
  "private": true,
  "bin": "./bin/poe",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias",
    "test": "tsx --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "docs": "./bin/poe inspect",
    "format": "biome format --write src",
    "lint": "biome lint --write src"
  },
  "devDependencies": {
    "@dod/config": "workspace:*",
    "@types/lodash": "^4.17.25",
    "@types/node": "^25.6.2",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.9",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "lodash": "^4.18.1",
    "zod": "^4.4.2"
  }
}
